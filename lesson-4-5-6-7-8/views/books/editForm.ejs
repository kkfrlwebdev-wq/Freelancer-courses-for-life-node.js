<!DOCTYPE html>
<html lang="uk">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= isEditing ? "Редагування книги" : "Додавання книги" %></title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
</head>

<body>
    <main class="book-form-page">
        <section class="book-form-card">
            <div class="book-form-header">
                <h1>
                    <%= isEditing ? "Редагування книги" : "Додати книгу" %>
                </h1>

            </div>

            <% if (errors?.length) { %>
                <div class="validation-errors" role="alert">
                    <ul>
                        <% errors.forEach(function(error) { %>
                            <li><%= error %></li>
                        <% }) %>
                    </ul>
                </div>
            <% } %>

            <form class="book-form" action="<%= isEditing ? `/books/${dataBook._id}` : '/books' %>" method="POST">
                <div class="form-row">
                    <label for="book-name">Назва книги</label>
                    <input id="book-name" name="name" type="text" value="<%= dataBook?.name ?? '' %>" required />
                </div>

                <div class="form-row">
                    <label for="book-author">Автор</label>
                    <% const selectedAuthorId = dataBook?.author?._id ?? dataBook?.author ?? ''; %>
                    <select id="book-author" name="author" required>
                        <option value="">Оберіть автора</option>
                        <% authors.forEach(function(author) { %>
                            <option value="<%= author._id %>"
                                <%= String(selectedAuthorId) === String(author._id) ? 'selected' : '' %>>
                                <%= author.name %><%= author.title ? ` — ${author.title}` : '' %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-row">
                    <label for="book-category">Категорія</label>
                    <input id="book-category" name="category" type="text" value="<%= dataBook?.category ?? '' %>" required />
                </div>

                <div class="form-row">
                    <label for="book-year">Рік видання</label>
                    <input id="book-year" name="year" type="number" min="1900" max="2100" value="<%= dataBook?.year ?? '' %>"
                        required />
                </div>

                <div class="form-row">
                    <label for="book-price">Ціна</label>
                    <input id="book-price" name="price" type="number" min="0" step="0.01" value="<%= dataBook?.price ?? '' %>" required />
                </div>

                <div class="form-row">
                    <label for="book-stock">Кількість на складі</label>
                    <input id="book-stock" name="inStock" type="number" min="0" value="<%= dataBook?.inStock ?? '' %>"
                        required />
                </div>

                <div class="form-row">
                    <label for="book-description">Опис</label>
                    <textarea id="book-description" name="description" rows="5"
                        required><%= dataBook?.description ?? '' %></textarea>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-save">Зберегти</button>
                    <a href="/books" class="btn btn-delete">Скасувати</a>
                </div>
            </form>
        </section>
    </main>
</body>

</html>
